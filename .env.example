# Copy this file to .env and fill in your values.
#
# Any value below may instead be the *name* of another environment variable
# already set in your shell/host (e.g. a secret injected by your deployment
# platform). If a variable with that name exists, its value is used;
# otherwise the literal value written here is used as-is.
# Example: REDIS_DB_PASSWORD=REDIS_PASSWORD looks up REDIS_PASSWORD first
# and falls back to the literal string "REDIS_PASSWORD" if it isn't set.

# ---- Self-managed Redis database ----
# Used by RedisVL for the semantic cache and semantic router (utils.py).
REDIS_DB_HOST=localhost
REDIS_DB_PORT=6379
REDIS_DB_USER=default
REDIS_DB_PASSWORD=
# Path to the semantic router's route definitions, relative to the app
# directory (or absolute). Read as a literal file path.
LLM_ROUTER_FILE=semantic-routes.json

# ---- Redis Agent Memory (Cloud) REST API ----
# Endpoint, store ID and API key from the Agent Memory service's
# Configuration tab in the Redis Cloud console. URL must include https://.
AGENT_MEMORY_SERVICE_URL=https://your-agent-memory-endpoint
AGENT_MEMORY_STORE_ID=your-store-id
AGENT_MEMORY_API_KEY=your-agent-memory-api-key

# ---- Redis LangCache (Cloud) REST API ----
# Endpoint, cache ID and API key from the LangCache service's Configuration
# tab in the Redis Cloud console. URL must include https://.
LANG_CACHE_SERVICE_URL=https://your-lang-cache-endpoint
LANG_CACHE_CACHE_ID=your-cache-id
LANG_CACHE_API_KEY=your-lang-cache-api-key
# Minimum similarity score (0-1) for an FAQ knowledge base match. Higher is stricter.
LANG_CACHE_SEMANTIC_THRESHOLD=0.75
# Path to the FAQ knowledge base entries, relative to the app directory (or
# absolute). Read as a literal file path.
KNOWLEDGE_BASE_FILE=knowledge-base.json

# ---- LLM ----
OPENAI_API_KEY=your-openai-api-key
# Path to the system prompt file, relative to the app directory (or absolute).
LLM_PROMPT=llm_prompt
